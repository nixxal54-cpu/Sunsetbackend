# ==========================================
# Z.ai GLM-4.7-Flash Streaming Backend Config
# ==========================================

# Required: Z.ai API Key from https://z.ai
# Keep this strictly server-side. Never expose to clients.
ZAI_API_KEY=""

# Optional: Z.ai Base URL (defaults to official https://api.z.ai/api/paas/v4)
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"

# Port to listen on (default: 3000)
PORT="3000"

# CORS Allowed Origins (comma-separated or * for all origins)
ALLOWED_ORIGINS="*"

# Rate Limiting: Max requests per IP window
RATE_LIMIT_MAX="60"

# Rate Limiting Window in milliseconds (e.g., 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS="60000"

# Upstream Z.ai Request Timeout in milliseconds (default: 120000 = 2 minutes)
UPSTREAM_TIMEOUT="120000"

# Application URL (injected in AI Studio / Cloud Run)
APP_URL=""
